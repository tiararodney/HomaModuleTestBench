#!/bin/busybox sh
# Init for the battery's VM smoke test. Loads homa.ko, sanity-checks it,
# unloads it, and reports one sentinel line that battery.sh greps for:
#   HOMA_VM_SMOKE: PASS   or   HOMA_VM_SMOKE: FAIL (<step>)
# Always resets the VM at the end; QEMU runs with -no-reboot, which
# turns the reset into a QEMU exit (tinyconfig has no ACPI poweroff).

/bin/busybox --install -s /bin
export PATH=/bin

fail() {
    echo "HOMA_VM_SMOKE: FAIL ($1)"
    reboot -f
}

mount -t proc proc /proc || fail mount-proc
mount -t sysfs sysfs /sys || fail mount-sys

echo "homa smoke test on $(uname -r)"

insmod /homa.ko || fail insmod
grep -q '^homa ' /proc/modules || fail not-in-proc-modules

# The module registers its sysctls when it loads; their absence means it
# did not initialize properly even if insmod returned 0.
[ -d /proc/sys/net/homa ] || fail no-sysctls

rmmod homa || fail rmmod
grep -q '^homa ' /proc/modules && fail still-loaded-after-rmmod

echo "HOMA_VM_SMOKE: PASS"
reboot -f
